{
  "name": "result-rpc",
  "version": "0.4.0",
  "description": "Typed RPC for React: errors accumulate along the call path and discharge along the component tree",
  "keywords": [
    "agent-skill",
    "query-cache",
    "react",
    "result",
    "rpc",
    "tagged-errors",
    "trpc-alternative",
    "type-safe",
    "typed-rpc",
    "typescript"
  ],
  "homepage": "https://result-rpc.com",
  "bugs": "https://github.com/jokull/result-rpc/issues",
  "license": "MIT",
  "author": "Jökull Sólberg <jokull@solberg.is>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jokull/result-rpc.git"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "ARCHITECTURE.md",
    "DESIGN.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./query": {
      "types": "./dist/query/runtime.d.ts",
      "import": "./dist/query/runtime.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "test": "bun test src examples tests",
    "test:demo": "npm --prefix demo install && npm --prefix demo test",
    "test:package": "node scripts/package-smoke.mjs",
    "test:release": "node --test scripts/release-plan.test.mjs",
    "test:diagnostics": "node scripts/diagnostic-smoke.mjs",
    "test:docs": "node scripts/docs-typecheck.mjs",
    "test:entity-perf": "RESULT_RPC_PERF=1 bun test tests/entity/attack-10-perf.test.ts",
    "test:types": "tsc -p tsconfig.type-tests.json --noEmit",
    "docs:verify": "pnpm --dir website check && pnpm --dir website validate && pnpm --dir website build && node scripts/agent-docs-smoke.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test:types && pnpm test:release && pnpm test:diagnostics && pnpm test && pnpm build && node scripts/api-report.mjs && pnpm test:docs && pnpm test:package",
    "verify:release": "pnpm verify && pnpm bench:types && pnpm test:entity-perf && pnpm docs:verify",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run verify:release",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "release:check": "node scripts/release-check.mjs",
    "api:report": "pnpm build && node scripts/api-report.mjs --update",
    "api:report:check": "pnpm build && node scripts/api-report.mjs",
    "bench:types": "node bench/types.mjs",
    "prepare": "bun run build"
  },
  "dependencies": {
    "@tanstack/query-core": "^5.101.4",
    "devalue": "5.8.2",
    "temporal-polyfill": "^1.0.3"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@changesets/cli": "3.0.0",
    "@microsoft/api-extractor": "7.58.12",
    "@tanstack/react-router": "^1.170.18",
    "@types/bun": "^1.3.14",
    "@types/node": "22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "better-result": "^3.0.0",
    "db-result": "^0.2.0",
    "drizzle-orm": "1.0.0-rc.4",
    "next": "16.2.12",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "publint": "0.3.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-test-renderer": "^19.2.8",
    "server-only": "0.0.1",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2",
    "typescript-5-4": "npm:typescript@5.4.5",
    "typescript-5-9": "npm:typescript@5.9.3",
    "vite": "8.1.5"
  },
  "peerDependencies": {
    "better-result": "^3.0.0",
    "react": ">=18.3"
  },
  "engines": {
    "node": ">=20.19.5"
  },
  "packageManager": "pnpm@11.9.0"
}
