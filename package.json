{
  "name": "result-rpc",
  "version": "0.1.0",
  "description": "One Result and one wire-safe error union from server to screen",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "DESIGN.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:types": "tsc -p tsconfig.type-tests.json --noEmit",
    "verify": "pnpm check && pnpm test:types && pnpm test && pnpm build",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run verify"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.18",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "drizzle-orm": "1.0.0-rc.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-test-renderer": "^19.2.8",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "J\u00f6kull S\u00f3lberg <jokull@solberg.is>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jokull/result-rpc.git"
  },
  "homepage": "https://result-rpc.solberg.is",
  "bugs": "https://github.com/jokull/result-rpc/issues",
  "keywords": [
    "rpc",
    "typescript",
    "react",
    "result",
    "tagged-errors",
    "trpc-alternative",
    "query-cache",
    "type-safe"
  ],
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@tanstack/query-core": "^5.101.4",
    "devalue": "5.8.2"
  },
  "peerDependencies": {
    "react": ">=18.3",
    "drizzle-orm": ">=1.0.0-rc"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  }
}
