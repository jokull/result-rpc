{
  "name": "result-rpc-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run cf-typegen && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run cf-typegen && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "deploy": "npm run build && wrangler deploy",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --import tsx --test tests/rendered-html.integration.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "cf-typegen": "wrangler types --config wrangler.jsonc",
    "cf-types:check": "wrangler types --check --config wrangler.jsonc",
    "typecheck": "npm run cf-typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "result-rpc": "file:.."
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vinext": "1.0.1",
    "vite": "8.3.2",
    "wrangler": "4.146.0"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
