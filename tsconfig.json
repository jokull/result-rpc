{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "examples/**/*.ts",
    "examples/**/*.tsx"
  ],
  // The framework examples (09/10/11) are real installable apps: each imports
  // the package by name, and brings its own tsconfig, node_modules, and
  // framework-generated types. They typecheck in their own directories.
  "exclude": ["examples/09-waku", "examples/10-nextjs", "examples/11-tanstack-start"]
}
